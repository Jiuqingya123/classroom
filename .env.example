# ── 服务端基础 ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# 数据库与文件存放目录（相对路径基于 packages/server）
DB_PATH=./data/app.db
DATA_DIR=./data

# ── 安全 ────────────────────────────────────────────────────
# 生产环境必须换成 32 字节以上随机串： openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-please-32bytes
ACCESS_TTL_SECONDS=900
RTC_TTL_SECONDS=7200
REFRESH_TTL_DAYS=7

# 允许的来源（Electron 打包后渲染进程 origin 为 file://，dev 为 localhost:5273）
# 多个用逗号分隔。漏了 dev 端口会让登录直接报 "Failed to fetch"（CORS 被拒）
# 后三个是浏览器/Android WebView（Capacitor）的 origin，移动端必须放行
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5273,http://localhost,https://localhost,capacitor://localhost,file://,null

# ── 对外地址（用于拼文件 URL） ────────────────────────────────
PUBLIC_BASE_URL=http://localhost:8080

# ── TURN（coturn use-auth-secret 模式，Phase 2 起生效） ────────
# 留空则只下发 STUN，局域网/同 NAT 可用，跨网会失败
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=
TURN_SECRET=
TURN_TTL_SECONDS=3600

# ── 限制 ────────────────────────────────────────────────────
MAX_PARTICIPANTS=5
MAX_UPLOAD_MB=5

# ── 腾讯云实时互动-教育版（LCIC）并列入口（临时桥接） ──────────
# 产品已公告 2026-10-30 起停止新购；仅存量付费客户可用，随时可能下线。
# 留空任意一项或设 LCIC_ENABLED=false 即完全关闭：前端不显示按钮，接口返回 503。
# 密钥只放环境变量，绝不要提交到仓库；建议使用子账号最小权限并在联调后轮换。
LCIC_ENABLED=true
LCIC_SDK_APP_ID=
LCIC_SECRET_ID=
LCIC_SECRET_KEY=
LCIC_API_ENDPOINT=lcic.tencentcloudapi.com
LCIC_CLASS_DOMAIN=class.qcloudclass.com
# 腾讯限制单房间最长 24 小时；到期后下次点击自动新建
LCIC_ROOM_TTL_HOURS=24
