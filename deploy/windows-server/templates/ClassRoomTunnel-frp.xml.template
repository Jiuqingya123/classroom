<service>
  <id>ClassRoomTunnel</id>
  <name>ClassRoom Tunnel (frp)</name>
  <description>把本机 8090 反向隧道到云端 127.0.0.1:8091</description>
  <executable>{{ROOT}}\tunnel\frpc.exe</executable>
  <arguments>-c "{{ROOT}}\tunnel\frpc.toml"</arguments>
  <workingdirectory>{{ROOT}}\tunnel</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>{{ROOT}}\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
