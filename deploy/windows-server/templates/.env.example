NODE_ENV=production
PORT=8090
HOST=127.0.0.1
LOG_LEVEL=info

DB_PATH=./data/app.db
DATA_DIR=./data

JWT_SECRET=please-change-me-at-install-time
ACCESS_TTL_SECONDS=900
RTC_TTL_SECONDS=7200
REFRESH_TTL_DAYS=7

ALLOWED_ORIGINS=http://<PROD_SERVER_IP>:9999,http://<PROD_SERVER_IP>,http://localhost:5273,http://localhost,https://localhost,capacitor://localhost,file://,null
PUBLIC_BASE_URL=http://<PROD_SERVER_IP>:9999

TURN_HOST=<PROD_SERVER_IP>
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_REALM=classroom
TURN_SECRET=
TURN_TTL_SECONDS=3600

MAX_PARTICIPANTS=5
MAX_UPLOAD_MB=50
