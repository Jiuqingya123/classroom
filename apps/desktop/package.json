{
  "name": "@classroom/desktop",
  "version": "1.1.6",
  "private": true,
  "description": "ClassIn 类在线教室桌面客户端",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:dir": "npm run build && node ../../scripts/clean-dist.cjs && electron-builder --dir",
    "dist": "npm run build && node ../../scripts/clean-dist.cjs && electron-builder",
    "dist:mac": "npm run build && node ../../scripts/clean-dist.cjs && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && node ../../scripts/clean-dist.cjs && electron-builder --win --x64",
    "dist:linux": "npm run build && node ../../scripts/clean-dist.cjs && electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "@classroom/client-core": "*",
    "@classroom/shared": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "konva": "^10.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "zustand": "^5.0.16",
    "pdfjs-dist": "^6.4.299"
  },
  "author": "ClassRoom"
}
